# =====================================================
# 开发环境配置
# =====================================================
# 复制此文件为 .env.development 后按需修改

# 应用版本号（构建时注入到 __APP_VERSION__）
VITE_VERSION=1.0.0

# 开发服务器端口
VITE_PORT=5173

# 应用部署的基础路径（开发环境通常为 '/'）
VITE_BASE_URL=/

# axios baseURL：留空，让各 api/** 文件中声明的 /api/... 直接作为请求路径
VITE_API_URL=

# API 代理目标（开发服务器将 /api 转发到此地址）
VITE_API_PROXY_URL=http://127.0.0.1:3000

# axios 是否携带 cookie（'true' | 'false'）
VITE_WITH_CREDENTIALS=false

# 访问模式：frontend（前端控制路由/权限） | backend（后端下发菜单）
VITE_ACCESS_MODE=frontend

# 是否启用本地 Mock（'true' | 'false'）
VITE_USE_MOCK=false

# 是否在构建时生成 .gz 压缩文件（'true' | 'false'）
VITE_USE_GZIP=false

# 是否启用 CDN 加载外部依赖（'true' | 'false'）
VITE_USE_CDN=false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY=art-design-pro-lock-key

# 是否在控制台输出当前路由信息（仅调试用）
VITE_OPEN_ROUTE_INFO=false
