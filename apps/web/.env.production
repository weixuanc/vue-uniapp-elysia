# =====================================================
# 生产环境配置
# =====================================================
# 复制此文件为 .env.production 后按需修改

# 应用版本号（构建时注入到 __APP_VERSION__）
VITE_VERSION=1.0.0

# 预览服务器端口（仅用于 vite preview）
VITE_PORT=4173

# 应用部署的基础路径（按实际部署填写，如 '/admin/' 或 CDN 域名）
VITE_BASE_URL=/

# axios baseURL：留空，让各 api/** 文件中声明的 /api/... 直接作为请求路径
VITE_API_URL=

# API 代理目标（生产环境通常不需要代理，可与服务端一致或留空）
VITE_API_PROXY_URL=https://api.example.com

# axios 是否携带 cookie（'true' | 'false'）
VITE_WITH_CREDENTIALS=false

# 访问模式：frontend（前端控制路由/权限） | backend（后端下发菜单）
VITE_ACCESS_MODE=backend

# 是否启用本地 Mock（生产环境必须为 false）
VITE_USE_MOCK=false

# 是否在构建时生成 .gz 压缩文件（'true' | 'false'）
VITE_USE_GZIP=true

# 是否启用 CDN 加载外部依赖（'true' | 'false'）
VITE_USE_CDN=false

# 锁屏加密密钥（生产环境务必修改为强随机串）
VITE_LOCK_ENCRYPT_KEY=change-me-in-production

# 是否在控制台输出当前路由信息（生产环境必须为 false）
VITE_OPEN_ROUTE_INFO=false
